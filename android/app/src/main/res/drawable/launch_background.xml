<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de arranque (Android 11 o anterior): fondo de la app y el logo en
     el centro, para que el paso a la primera pantalla de Flutter no se note.
     En Android 12 o posterior el sistema muestra el ícono de la app sobre el
     mismo fondo (ver values-v31/styles.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background_color" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
